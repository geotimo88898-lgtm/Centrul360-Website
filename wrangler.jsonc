// Cloudflare Workers: Centrul360 (site, portal admin/staff, api/, mașina de creative la /creative), un singur Worker.
// Build: `node cf/build.mjs` (vezi comentariul de acolo), apoi `npx wrangler deploy`. Pe Vercel nu se folosește.
// Fișierele (fostul Vercel Blob) sunt în R2: BLOB = portalul, CREATIVE_BLOB = creativele, cu aceleași căi.
// Ceasul: o singură expresie, din oră în oră la :17 (cf/worker.js scheduled): automatizările în fiecare oră (ca ceasul
// de pe GitHub, care primea 401 după mutare), plus la 05 producția de creative și la 19 raportul zilei. Oprit cu CRON_ON = "0".
{
  "name": "centrul360-website",
  "keep_vars": true,
  "main": "cf/worker.js",
  "minify": true,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_fs_module"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/", "/login", "/portal", "/portal.html", "/portal-login", "/portal-login.html", "/fise/*", "/academy-fisa/*", "/api/*", "/creative", "/creative/*", "/__c360/*", "/academy-vsl/*", "/brand_asset/vsl/*", "/brand_asset/ba-hifu-profil.mp4", "/brand_asset/epilare.mp4", "/brand_asset/hifu-procedura.mp4", "/brand_asset/offer-epilare-4zone.mp4", "/brand_asset/promo-summer.mp4", "/brand_asset/video-client.mp4", "/brand_asset/video-prezentare.mp4"]
  },
  "alias": {
    "@vercel/blob": "./cf/blob-r2.js",
    "@vercel/blob/client": "./cf/blob-client-r2.js"
  },
  // seed/ al mașinii de creative, citit cu node:fs (la /bundle/seed)
  "base_dir": ".cf-mods",
  "find_additional_modules": true,
  "rules": [
    { "type": "Text", "globs": ["seed/**/*.json", "seed/**/*.md"], "fallthrough": true },
    { "type": "Data", "globs": ["seed/**/*.png", "seed/**/*.jpg", "seed/**/*.jpeg", "seed/**/*.webp"], "fallthrough": true }
  ],
  "r2_buckets": [
    { "binding": "BLOB", "bucket_name": "centrul360-private" },
    { "binding": "CREATIVE_BLOB", "bucket_name": "centrul360-creatives" }
  ],
  "workflows": [
    { "name": "centrul360-creative-jobs", "binding": "CREATIVE_JOBS", "class_name": "CreativeJobs" }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "CRON_ON": "1", "BLOB_STORE_ID": "r2" },
  // cheile comune din Secrets Store (ANTHROPIC, GEMINI, FB_APP_ID, FB_APP_SECRET; comune cu celelalte afaceri)
  "secrets_store_secrets": [
    { "binding": "ANTHROPIC_API_KEY", "store_id": "98ffae7c25e0415ab8515b612df054a9", "secret_name": "ANTHROPIC_API_KEY" },
    { "binding": "GEMINI_API_KEY", "store_id": "98ffae7c25e0415ab8515b612df054a9", "secret_name": "GEMINI_API_KEY" },
    { "binding": "FB_APP_ID", "store_id": "98ffae7c25e0415ab8515b612df054a9", "secret_name": "FB_APP_ID" },
    { "binding": "FB_APP_SECRET", "store_id": "98ffae7c25e0415ab8515b612df054a9", "secret_name": "FB_APP_SECRET" }
  ],
  "observability": { "enabled": true }
}
