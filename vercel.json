{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/portal",
      "has": [
        {
          "type": "host",
          "value": "www.centrul360.com"
        }
      ],
      "destination": "https://admin.centrul360.com/",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "has": [
        {
          "type": "host",
          "value": "www.centrul360.com"
        }
      ],
      "destination": "https://admin.centrul360.com/",
      "permanent": false
    },
    {
      "source": "/portal-login",
      "has": [
        {
          "type": "host",
          "value": "www.centrul360.com"
        }
      ],
      "destination": "https://admin.centrul360.com/login",
      "permanent": false
    },
    {
      "source": "/portal-login.html",
      "has": [
        {
          "type": "host",
          "value": "www.centrul360.com"
        }
      ],
      "destination": "https://admin.centrul360.com/login",
      "permanent": false
    },
    {
      "source": "/portal",
      "has": [
        {
          "type": "host",
          "value": "admin.centrul360.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "has": [
        {
          "type": "host",
          "value": "admin.centrul360.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal-login",
      "has": [
        {
          "type": "host",
          "value": "admin.centrul360.com"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/portal-login.html",
      "has": [
        {
          "type": "host",
          "value": "admin.centrul360.com"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/portal",
      "has": [
        {
          "type": "host",
          "value": "staff.centrul360.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal.html",
      "has": [
        {
          "type": "host",
          "value": "staff.centrul360.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/portal-login",
      "has": [
        {
          "type": "host",
          "value": "staff.centrul360.com"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/portal-login.html",
      "has": [
        {
          "type": "host",
          "value": "staff.centrul360.com"
        }
      ],
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/creative",
      "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative"
    },
    {
      "source": "/creative/:path*",
      "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative/:path*"
    }
  ],
  "headers": [
    {
      "source": "/brand_asset/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/automation-tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/daily-report",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/ads-publish.js": {
      "maxDuration": 60
    },
    "api/automation-tick.js": {
      "maxDuration": 60
    },
    "api/portal-whatsapp.js": {
      "maxDuration": 60
    },
    "api/ads-manager.js": {
      "maxDuration": 60
    },
    "api/portal-mypos.js": {
      "maxDuration": 60
    },
    "api/portal-ghl.js": {
      "maxDuration": 60
    },
    "api/daily-report.js": {
      "maxDuration": 60
    },
    "api/kpi.js": {
      "maxDuration": 60
    },
    "api/offers-kpi.js": {
      "maxDuration": 60
    },
    "api/portal-integrations.js": {
      "maxDuration": 60
    }
  }
}
