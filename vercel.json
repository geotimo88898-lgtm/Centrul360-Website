{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/creative", "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative" },
    { "source": "/creative/:path*", "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative/:path*" }
  ],
  "headers": [
    {
      "source": "/brand_asset/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    }
  ]
}
