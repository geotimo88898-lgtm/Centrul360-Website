{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.centrul360.com"
        }
      ],
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "staff.centrul360.com"
        }
      ],
      "destination": "/portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/creative",
      "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative"
    },
    {
      "source": "/creative/:path*",
      "destination": "https://centrul360-creative-machine-centrul360.vercel.app/creative/:path*"
    }
  ],
  "headers": [
    {
      "source": "/brand_asset/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/automation-tick",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/ads-publish.js": {
      "maxDuration": 60
    },
    "api/ads-manager.js": {
      "maxDuration": 60
    },
    "api/portal-mypos.js": {
      "maxDuration": 60
    }
  }
}
